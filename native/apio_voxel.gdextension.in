[configuration]

entry_symbol = "apio_voxel_init"
compatibility_minimum = "4.5"
reloadable = false

[libraries]

windows.debug.x86_64 = "res://bin/libapio_voxel.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://bin/libapio_voxel.windows.template_release.x86_64.dll"
linux.debug.x86_64 = "res://bin/libapio_voxel.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://bin/libapio_voxel.linux.template_release.x86_64.so"
