static var _cache := {}


static func icon(slot: String) -> Texture2D:
	if _cache.has(slot):
		return _cache[slot]
	var rows: Array = ART[slot]
	var image := Image.create(16, 16, false, Image.FORMAT_RGBA8)
	image.fill(Color(0, 0, 0, 0))
	for y in 16:
		for x in 16:
			if rows[y][x] == "#":
				image.set_pixel(x, y, Color(0.55, 0.52, 0.46, 0.55))
	var texture := ImageTexture.create_from_image(image)
	_cache[slot] = texture
	return texture
